{
  "name": "@arwes/react",
  "version": "1.0.0-next.25020502",
  "publishConfig": {
    "access": "public"
  },
  "description": "Futuristic Sci-Fi UI Web Framework",
  "keywords": [
    "arwes",
    "ui",
    "front-end",
    "framework",
    "scifi",
    "sci-fi",
    "science-fiction"
  ],
  "homepage": "https://arwes.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arwes/arwes.git"
  },
  "bugs": {
    "url": "https://github.com/arwes/arwes/issues"
  },
  "funding": "https://github.com/sponsors/romelperez",
  "license": "MIT",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js"
    },
    "./build/": {
      "default": "./build/"
    }
  },
  "types": "./build/esm/index.d.ts",
  "module": "./build/esm/index.js",
  "main": "./build/cjs/index.js",
  "peerDependencies": {
    "react": "18"
  },
  "dependencies": {
    "@arwes/react-animated": "workspace:^",
    "@arwes/react-animator": "workspace:^",
    "@arwes/react-bgs": "workspace:^",
    "@arwes/react-bleeps": "workspace:^",
    "@arwes/react-core": "workspace:^",
    "@arwes/react-effects": "workspace:^",
    "@arwes/react-frames": "workspace:^",
    "@arwes/react-text": "workspace:^",
    "@arwes/react-tools": "workspace:^",
    "arwes": "workspace:^",
    "tslib": "2"
  },
  "scripts": {
    "build": "pnpm run build-esm && pnpm run build-cjs",
    "build-esm": "sh ../../scripts/pkg-build-esm.sh",
    "build-cjs": "sh ../../scripts/pkg-build-cjs.sh",
    "dev": "sh ../../scripts/pkg-build-esm.sh --watch"
  }
}
